def figure_06_time_delay():
    t = np.linspace(0, 10, 400)
    signal = np.sin(2 * np.pi * t)
    delayed_signal = np.sin(2 * np.pi * (t - 0.5))

    plt.figure(figsize=(8, 6))
    plt.plot(t, signal, label="Reference Signal")
    plt.plot(t, delayed_signal, label="Delayed Signal", linestyle="--")
    plt.title("Figure 06 — Time Delay")
    plt.xlabel("Time")
    plt.ylabel("Signal")
    plt.legend()
    plt.grid(True)
    plt.savefig("outputs/figure-6-time-delay.png", dpi=150, bbox_inches="tight")
    plt.close()
