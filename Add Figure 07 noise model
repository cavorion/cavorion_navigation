def figure_10_navigation_overview():
    fig, ax = plt.subplots(figsize=(10, 6))

    nodes = {
        "Signals": (1, 3),
        "Estimation": (3, 3),
        "Dial": (5, 3),
        "Door": (7, 3),
        "Action": (9, 3),
    }

    for label, (x, y) in nodes.items():
        ax.scatter(x, y, s=1200)
        ax.text(x, y, label, ha="center", va="center", color="white", fontsize=10)

    pairs = [("Signals", "Estimation"), ("Estimation", "Dial"), ("Dial", "Door"), ("Door", "Action")]
    for a, b in pairs:
        x1, y1 = nodes[a]
        x2, y2 = nodes[b]
        ax.plot([x1, x2], [y1, y2], linewidth=2)

    ax.set_title("Figure 10 — Navigation Overview")
    ax.set_xlim(0, 10)
    ax.set_ylim(2, 4)
    ax.axis("off")
    plt.savefig("outputs/figure-10-navigation-overview.png", dpi=150, bbox_inches="tight")
    plt.close()
