def figure_09_dial_concept():
    theta = np.linspace(0, 2 * np.pi, 400)
    r = np.ones_like(theta)

    plt.figure(figsize=(7, 7))
    ax = plt.subplot(111, polar=True)
    ax.plot(theta, r)
    ax.set_title("Figure 09 — Dial Concept", va="bottom")
    ax.plot([np.pi / 3, np.pi / 3], [0, 1], linewidth=3)
    plt.savefig("outputs/figure-9-dial-concept.png", dpi=150, bbox_inches="tight")
    plt.close()
